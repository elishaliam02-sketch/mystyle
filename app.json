{
  "expo": {
    "name": "APEX",
    "slug": "mystyle",
    "scheme": "mystyle",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0D10",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "APEX uses your photos so you can add progress pictures.",
          "cameraPermission": "APEX uses the camera so you can take progress pictures."
        }
      ]
    ],
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mystyle.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mystyle.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "APEX",
      "shortName": "APEX",
      "lang": "he",
      "display": "standalone",
      "themeColor": "#0B5CFF",
      "backgroundColor": "#0B0D10",
      "description": "APEX — habits, food and training in one place."
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "liamjshsh",
    "extra": {
      "eas": {
        "projectId": "e358385f-c11a-4a79-be59-862cede81a5c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e358385f-c11a-4a79-be59-862cede81a5c",
      "fallbackToCacheTimeout": 15000
    }
  }
}
